# ==============================================================================
# ENSEMBLE ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Scene Director (Google AI Studio Gemini - 8k output, 1M TPM)
DIRECTOR_API_KEY=
DIRECTOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DIRECTOR_MODEL=gemini-2.5-flash

# Scene Chunking Configuration
SCENE_TARGET_WORDS=1000
SCENE_MIN_WORDS=600
SCENE_MAX_WORDS=1400

# 2. Casting Producer (Groq - Fast Character Analysis)
PRODUCER_API_KEY=
PRODUCER_BASE_URL=https://api.groq.com/openai/v1
PRODUCER_MODEL=qwen/qwen3.8-27b

# 3. Kokoro Neural Audio Models (Local ONNX)
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin

# 4. Optional Fallback Providers
GROQ_DIRECTOR_API_KEY=
GROQ_DIRECTOR_BASE_URL=https://api.groq.com/openai/v1
GROQ_DIRECTOR_MODEL=qwen/qwen3.8-27b
